# Directorio donde se guardan los uploads dentro del contenedor
UPLOAD_DIR=/tmp/rmi

# Contraseña para subir archivos (uploader publico)
UPLOAD_PASSWORD=rmi2024

# Contraseña para el panel /admin
ADMIN_PASSWORD=admin2024

# Resend - notificacion email al subir archivos y al hacer deploy
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=RMI Uploader <noreply@tudominio.com>

# Email que recibe la confirmacion cuando se corre update-rmi.sh
# Tambien se puede pasar como segundo argumento: ./update-rmi.sh gestion admin@empresa.com
DEPLOY_NOTIFY_EMAIL=admin@tudominio.com
